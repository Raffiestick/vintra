rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Treat either role=admin or token.admin=true as admin.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // JACKETS
    // DEV behavior: allow any SIGNED-IN user to READ so preview pages render.
    // Writes remain ADMIN-only.
    // NOTE: We'll tighten reads later before production.
    match /jackets/{vin} {
      allow read: if isAdmin() || isSignedIn();
      allow write: if isAdmin();
    }

    // All other collections default to deny unless separately allowed elsewhere.
  }
}