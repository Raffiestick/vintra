rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      // Checks for the 'admin' custom claim on the auth token.
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{uid} {
      // A new user can create their own document during signup.
      allow create: if isOwner(uid);
      
      // Admins can list all users; authenticated users can only get their own document.
      allow list: if isAdmin();
      allow get: if isOwner(uid) || isAdmin();

      // Users can update their own document; admins can update any document.
      allow update: if isOwner(uid) || isAdmin();
    }

    // Rules for the 'jackets' collection
    match /jackets/{jacketId} {
      // Admins can read any jacket.
      // A user can read a jacket if their UID matches the dealerId on the jacket.
      allow get, list: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.dealerId);

      // Only admins can create, update, or delete jackets.
      allow create, update, delete: if isAdmin();
    }
  }
}
