rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an admin by reading their user document
    function isAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin';
    }

    match /users/{userId} {
      // Allow users to create, read and update their own document.
      // This is the key fix: combining create with update/write permissions.
      allow get, write: if request.auth.uid == userId;

      // Admins can list any user document and create/update any user document
      allow list: if request.auth != null && isAdmin(request.auth.uid);
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    match /jackets/{jacketId} {
      // Allow any authenticated user to read all jackets.
      // Client-side queries will filter for permissions.
      allow read: if request.auth != null;
      
      // Only admins can create, update, or delete jackets
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
  }
}
