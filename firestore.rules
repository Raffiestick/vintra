
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an admin by reading their user document
    function isAdmin(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin';
    }

    match /users/{userId} {
      // Allow users to read, create, and update their own document
      allow get, update, create: if request.auth.uid == userId;

      // Admins can list and get any user document
      allow list, get: if request.auth != null && isAdmin(request.auth.uid);

      // Admins can also update any user document
      allow update: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    match /jackets/{jacketId} {
      // Allow any authenticated user to read all jackets, but we will filter on the client
      // A dealer can only read jackets assigned to them (enforced by client-side query)
      // An admin can read all jackets (enforced by client-side query)
      allow read: if request.auth != null;
      
      // Only admins can create, update, or delete jackets
      allow create, update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }
  }
}
