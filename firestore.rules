// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function dealerOwnsJacket(vin) { return isSignedIn() && get(/databases/$(database)/documents/jackets/$(vin)).data.dealerId == request.auth.uid; }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /stagingInvoices/{sid} {
      allow read, write, delete: if isAdmin();
      match /units/{doc} { allow read, write, delete: if isAdmin(); }
    }

    match /jackets/{vin} {
      // THE 'list' RULE IS NOW REMOVED
      allow read: if isAdmin() || dealerOwnsJacket(vin);
      allow create, update, delete: if isAdmin();
      match /activity/{doc} { allow read: if isAdmin() || dealerOwnsJacket(vin); allow write: if isAdmin(); }
      match /docs/{doc} { allow read: if isAdmin() || dealerOwnsJacket(vin); allow write: if isAdmin(); }
    }
    // ... other rules
  }
}