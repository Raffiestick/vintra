rules_version = '2';

// Helper function to check for admin role
function isAdmin() {
  return request.auth != null && request.auth.token.admin == true;
}

// Helper function to check if the user is the owner of a document
function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins can do anything, anywhere.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // USERS collection
    match /users/{userId} {
      // Users can create their own user document during sign-up.
      allow create: if isOwner(userId);
      // Users can read and update their own profile information.
      allow read, update: if isOwner(userId);
    }
    
    // JACKETS collection
    match /jackets/{vin} {
      // Dealers can only read jackets that are assigned to them.
      allow read: if request.auth != null && resource.data.dealerId == request.auth.uid;
      // No dealer write access to the main jacket document.
      allow write: if false;
    }
    
    // All other collections are admin-only by default because of the admin wildcard match above.
    // Explicitly denying dealer access to collections they should never touch.
    match /stagingInvoices/{docId=**} {
      allow read, write: if false; // Dealers cannot access staging
    }
    
    match /counters/{docId=**} {
      allow read, write: if false; // Dealers cannot access counters
    }
  }
}
