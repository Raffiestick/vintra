
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if the user is an admin
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Admins can read and write anything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow users to create their own profile document
      allow create: if request.auth.uid == userId;
      
      // Allow authenticated users to read profiles (non-admins)
      // Admins are already covered by the rule above
      allow read: if request.auth != null;

      // Allow users to update their own profile (non-admins)
      // Admins are already covered by the rule above
      allow update: if request.auth.uid == userId;
    }

    // Rules for 'jackets' collection (and subcollections)
    match /jackets/{vin}/{document=**} {
        // Allow any authenticated user to read jacket data and its subcollections.
        // This is necessary for dealers to view their assigned jackets.
        // Admin access is already granted above.
        allow read: if request.auth != null;
    }
    
    // Allow any authenticated user to read from the staging collections
    match /stagingInvoices/{sid}/{document=**} {
        allow read: if request.auth != null;
    }

    // Allow read access to counters for any authenticated user
    match /counters/{counterId} {
        allow read: if request.auth != null;
    }
  }
}
