rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Auth helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Two admin UIDs + optional custom claims for flexibility
    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.role == 'admin' ||
          request.auth.uid == '8usUL5P3Lde9UmukTHNhfArzDbs2' ||
          request.auth.uid == 'qY0IICPcxOSf8HTHwO83Qz6fxiG3'
        );
    }

    // Dealer is assigned to a jacket if jacket.dealerId == uid
    function isAssignedDealer(vin) {
      return isSignedIn() &&
             get(/databases/$(database)/documents/jackets/$(vin)).data.dealerId == request.auth.uid;
    }

    // --- Default deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: admin full control; user can read/update their own profile record
    match /users/{uid} {
      allow read, write: if isAdmin();
      allow read, create, update: if isSignedIn() && request.auth.uid == uid;
    }

    // Jackets: admin full control; assigned dealer read-only
    match /jackets/{vin} {
      allow read, write: if isAdmin();
      allow read: if isAssignedDealer(vin);

      // Activity timeline: dealer can read if assigned; only admin writes
      match /activity/{id} {
        allow read: if isAdmin() || isAssignedDealer(vin);
        allow write: if isAdmin();
      }
    }

    // Staging (AI parsing): admin-only
    match /stagingInvoices/{stagingId} {
      allow read, write: if isAdmin();

      match /units/{unitId} {
        allow read, write: if isAdmin();
      }
    }

    // Staged docs metadata: admin-only
    match /stagedDocs/{docId} {
      allow read, write: if isAdmin();
    }

    // Counters (e.g., invoice ID sequence): admin-only
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
