rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && (
             request.auth.token.admin == true
          || request.auth.token.role == 'admin'
          || request.auth.uid in ['8usUL5P3Lde9UmukTHNhfArzDbs2','qY0IICPcxOSf8HTHwO83Qz6fxiG3']
        );
    }

    // Users can manage their own profile; admins can manage all.
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Dealer jackets
    match /jackets/{vin} {
      allow read: if isAdmin() || (request.auth != null && resource.data.dealerId == request.auth.uid);
      allow create, update, delete: if isAdmin();

      match /activity/{docId} {
        allow read: if isAdmin() || (
          request.auth != null &&
          get(/databases/$(database)/documents/jackets/$(vin)).data.dealerId == request.auth.uid
        );
        allow write: if isAdmin();
      }
    }

    // Staging invoice batches: admin only
    match /stagingInvoices/{stagingId} {
      allow read, write: if isAdmin();
      match /units/{unitId} {
        allow read, write: if isAdmin();
      }
    }

    // Fallback: admins can still do everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
