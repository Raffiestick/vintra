rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Claims-based admin (kept)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    // DEV-only hard-coded admin UID bypass
    function isDevAdmin() {
      return isSignedIn() && request.auth.uid == "qY0IICPcxOSf8HTHwO83Qz6fxiG3";
    }

    // Dealer role (kept)
    function isDealer() {
      return isSignedIn() && request.auth.token.role == 'dealer';
    }

    // Jackets:
    // Read: admin OR dev-admin UID OR dealer that owns the jacket
    // Write: admin OR dev-admin UID
    match /jackets/{vin} {
      allow read: if isAdmin() || isDevAdmin() || (isDealer() && resource.data.dealerId == request.auth.uid);
      allow write: if isAdmin() || isDevAdmin();
    }

    // Users:
    // Read: Any signed-in user can read their own document. Admins can read any.
    // Create: Anyone can create their own user document (on signup).
    // Update: Any signed-in user can update their own document. Admins can update any.
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin() || isDevAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin() || isDevAdmin();
    }
  }
}
