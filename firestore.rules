rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if a user has the 'admin' role in their custom claims.
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    // Rules for the 'users' collection.
    match /users/{userId} {
      // Allow user creation for any authenticated user (signup).
      allow create: if request.auth != null;
      
      // Allow users to read, update, or delete their OWN document.
      // Admins can also perform these actions.
      allow read, update, delete: if request.auth.uid == userId || isAdmin();
    }
    
    // Rules for the 'jackets' collection
    match /jackets/{vin} {
       // Admins can do anything.
       // Assigned dealers can read their own jackets.
       allow read: if isAdmin() || (request.auth.uid == resource.data.dealerId);
       allow create, update, delete: if isAdmin();
    }

    // Fallback for any other path - only admins can access.
    // This is a safeguard. Specific rules above take precedence.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
