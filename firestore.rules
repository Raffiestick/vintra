rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users (Dealers)
    // - A user can create their own document on signup.
    // - A user can read or update their own document.
    // - Admins can read the list of users and get individual user documents.
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow list, get: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Jackets
    // - Can only be read/written by an authenticated user.
    // - Further specific access can be controlled by checking dealerId against auth.uid if needed.
    match /jackets/{vin} {
       allow read, write: if request.auth != null;
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
