rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // TEMP DEV BYPASS. Remove for production when custom claims are set.
    function isDevAdmin() {
      return signedIn() && request.auth.uid == "qY0IICPcxOSf8HTHwO83Qz6fxiG3";
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.role == 'admin') || isDevAdmin()
      );
    }

    // This rule allows admins to query the users collection,
    // which is needed for the admin dashboard.
    match /users/{uid} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if (signedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // jackets/{vin}
    match /jackets/{vin} {
      allow read: if isAdmin() || (signedIn() && resource.data.dealerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
  }
}