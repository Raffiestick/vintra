rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Hard-coded admin UIDs (your two admins)
    function isAdminUid() {
      return isSignedIn() && (
        request.auth.uid == "8usUL5P3Lde9UmukTHNhfArzDbs2" ||
        request.auth.uid == "qY0IICPcxOSf8HTHwO83Qz6fxiG3"
      );
    }

    // Custom-claim based admin (+ UID allow-list above)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == "admin" ||
        isAdminUid()
      );
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Dealer is assigned to a jacket if their uid matches jacket.dealerId
    function isAssignedDealer(vin) {
      return isSignedIn()
        && get(/databases/$(database)/documents/jackets/$(vin)).data.dealerId == request.auth.uid;
    }

    /* users/{uid} — dealers edit their own basic profile; admin can read/write anyone.
       Prevent non-admins from writing privileged fields like "role", "admin", "status". */
    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);

      allow create: if isSelf(uid)
        && !('role' in request.resource.data)
        && !('admin' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('status' in request.resource.data);

      allow update, delete: if isAdmin() || (
        isSelf(uid)
        && !('role' in request.resource.data)
        && !('admin' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('status' in request.resource.data)
      );
    }

    /* jackets/{vin} — admin full control; assigned dealer read-only */
    match /jackets/{vin} {
      allow read: if isAdmin() || isAssignedDealer(vin);
      allow create, update, delete: if isAdmin();

      // timeline
      match /activity/{id} {
        allow read: if isAdmin() || isAssignedDealer(vin);
        allow create, update, delete: if isAdmin();
      }
    }

    /* stagingInvoices — admin only (as per your design) */
    match /stagingInvoices/{sid} {
      allow read, write: if isAdmin();
      match /units/{unitId} {
        allow read, write: if isAdmin();
      }
    }

    /* stagedDocs — admin only */
    match /stagedDocs/{docId} {
      allow read, write: if isAdmin();
    }

    /* counters — admin only */
    match /counters/{name} {
      allow read, write: if isAdmin();
    }

    /* everything else: deny */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
