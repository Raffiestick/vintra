rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Admins can get single documents and list all users
      allow get, list: if request.auth.token.role == 'admin';
      // Any authenticated user can read their own document
      allow get: if request.auth.uid == userId;
      // Users can update their own info
      allow write: if request.auth.uid == userId;
    }

    match /jackets/{jacketId} {
        allow read, write, delete: if request.auth.token.role == 'admin';
        // Dealers can only read jackets assigned to them
        allow read: if request.auth.token.role == 'dealer' && resource.data.dealerId == request.auth.uid;
    }
  }
}
