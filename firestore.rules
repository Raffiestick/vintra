rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function dealerOwnsJacket() {
      // Safe: when resource does not exist, deny by default
      return isSignedIn() &&
             resource.data.dealerId != null &&
             resource.data.dealerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isSelf(uid) || isAdmin();
    }

    // Admin-only staging area
    match /stagingInvoices/{sid} {
      allow read, write: if isAdmin();
      match /units/{uid} {
        allow read, write: if isAdmin();
      }
    }

    // Jackets: admin RW; dealers RO for their assigned units
    match /jackets/{vin} {
      allow read: if isAdmin() || dealerOwnsJacket();
      allow write: if isAdmin();
      match /activity/{doc} {
        allow read: if isAdmin() || dealerOwnsJacket();
        allow write: if isAdmin();
      }
    }

    // Invoice counter
    match /counters/{doc} {
      allow read, write: if isAdmin();
    }

    // Optional: where you stage ad-hoc docs before attaching
    match /stagedDocs/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
