rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      // Checks for a custom claim 'role' set to 'admin'
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Rules for the 'users' collection
    match /users/{uid} {
      // A new user can create their own document during signup
      allow create: if isOwner(uid);
      
      // Admins can list all users; users can only get their own document
      allow list: if isAdmin();
      allow get: if isOwner(uid) || isAdmin();

      // Users can update their own document; admins can update any
      allow update: if isOwner(uid) || isAdmin();

      // Admins can delete users
      allow delete: if isAdmin();
    }
  }
}