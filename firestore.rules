rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow admins full read/write access to everything
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Allow users to manage their own document
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId && request.resource.data.uid == request.auth.uid;
    }

    // Allow logged-in dealers to read jackets assigned to them
    match /jackets/{vin} {
      allow read: if exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                   get(/databases/$(database)/documents/jackets/$(vin)).data.dealerId == request.auth.uid;
    }
  }
}
