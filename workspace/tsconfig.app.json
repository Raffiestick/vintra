{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "noImplicitAny": false
    },
    "include": [
      "next-env.d.ts",
      "src/app/**/*.ts",
      "src/app/**/*.tsx",
      "src/components/**/*.ts",
      "src/components/**/*.tsx",
      "src/lib/**/*.ts",
      "src/lib/**/*.tsx",
      "src/hooks/**/*.ts",
      "src/hooks/**/*.tsx"
    ],
    "exclude": [
      "node_modules",
      ".next",
      "dist",
      "build",
      "out",
      "functions",
      "functions/**",
      "src/functions",
      "src/functions/**"
    ]
  }
