rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the user-documents directory
    match /user-documents/{userId}/{allPaths=**} {
      // Allow read, write (create, update, delete) if the user is authenticated
      // and their UID matches the folder they are trying to access.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
