rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow any signed-in user to upload to their own invoices folder.
    match /invoices/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow any signed-in user to access the staging area for now.
    // We can tighten this to admins later.
    match /stagingInvoices/{sid}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}


