rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // Rules for user documents
    match /user-documents/{uid}/{path=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (
             request.resource.contentType.matches('image/.*')
             || request.resource.contentType == 'application/pdf'
           );
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
  }
}
