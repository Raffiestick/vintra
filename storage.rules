rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Admin uploads auction invoices here
    match /incoming/invoices/{uid}/{fileName} {
      allow read, write: if isAdmin();
    }

    // Dealer onboarding docs (resale cert, ID, etc.)
    match /user-documents/{uid}/{fileName} {
      allow write: if isSelf(uid);
      allow read: if isSelf(uid) || isAdmin();
    }

    // Jacket documents (invoices, BOS, titles, POA, images, etc.)
    match /jacket-documents/{vin}/{rest=**} {
      // Admin full access; dealer can read if jacket.dealerId == auth.uid
      allow write: if isAdmin();
      allow read: if isAdmin() ||
        firestore.get(/databases/(default)/documents/jackets/$(vin)).data.dealerId == request.auth.uid;
    }
  }
}
