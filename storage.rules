rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // --- RULE FOR NEW DEALER DOCUMENT UPLOADS ---
    // This allows a signed-in user to write files to their own folder.
    match /user-documents/{userId}/{allChildren=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow any authenticated user to read all files.
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Allow Admins to write to the jacket-documents folder.
    match /jacket-documents/{vin}/{allChildren=**} {
      allow write: if request.auth != null && isAdmin();
    }

    // Allow Admins to write files to the invoices folder.
    match /invoices/{userId}/{allChildren=**} {
      allow write: if request.auth != null && isAdmin();
    }
  }
}