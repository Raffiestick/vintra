rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if a jacket is assigned to the requesting user
    function isJacketAssigned(vin) {
      // Use get() on a full path to the document in Firestore
      return get(/databases/$(database)/documents/jackets/$(vin)).data.dealerId == request.auth.uid;
    }

    // Admins have full access to all files.
    match /{allPaths=**} {
      allow read, write: if request.auth.token.admin == true;
    }

    // Dealers can upload their own initial documents to a path scoped by their UID.
    match /user-documents/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
      // Dealers should also be able to read their own uploaded docs
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // Dealers can read files inside a specific jacket's folder only if that jacket is assigned to them in Firestore.
    match /jacket-documents/{vin}/{allPaths=**} {
      allow read: if request.auth != null && isJacketAssigned(vin);
    }
  }
}
