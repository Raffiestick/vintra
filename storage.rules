rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper to check admin status
    function isAdmin(request) {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Helper to check if a user is the assigned dealer for a jacket
    function isAssignedDealer(request, vin) {
      // Correct syntax for cross-service rule: firestore.get()
      let jacketPath = /databases/$(database)/documents/jackets/$(vin);
      return request.auth != null && firestore.get(jacketPath).data.dealerId == request.auth.uid;
    }

    // Admins can read/write all files.
    match /{allPaths=**} {
      allow read, write: if isAdmin(request);
    }

    // Dealers can upload their initial registration documents to their own folder.
    match /user-documents/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Jacket-specific documents (invoices, BOS, etc.).
    match /jacket-documents/{vin}/{allPaths=**} {
      // Dealers can only read files for jackets that are assigned to them.
      allow read: if isAssignedDealer(request, vin);
    }
  }
}
