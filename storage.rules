rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Rule for dealer document uploads
    match /dealer-documents/{uid}/{fileName} {
      allow write: if request.auth.uid == uid;
      allow read: if request.auth.uid == uid || request.auth.token.role == 'admin';
    }

    // Rule for admin invoice uploads
    match /invoice-uploads/{adminUid}/{fileName} {
      allow write: if request.auth.token.role == 'admin' && request.auth.uid == adminUid;
      allow read: if request.auth.token.role == 'admin';
    }
  }
}