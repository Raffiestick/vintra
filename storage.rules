rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Allow users to upload their own registration documents
    match /user-documents/{userId}/{allPaths=**} {
      allow write: if isOwner(userId);
      allow read: if isOwner(userId) || isAdmin();
    }

    // Rules for generated jacket documents (invoices, BOS, etc.)
    match /jacket-documents/{vin}/{allPaths=**} {
      // Admins can read and write all jacket documents.
      allow write: if isAdmin();
      
      // Dealers can only read documents for jackets assigned to them.
      // This is checked by looking up the corresponding jacket document in Firestore.
      allow read: if isAdmin() || (
        isAuth() && get(/databases/(default)/documents/jackets/$(vin)).data.dealerId == request.auth.uid
      );
    }
    
    // Fallback for any other paths
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
