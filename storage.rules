rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check admin status
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Admins can do anything, anywhere.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Dealers can upload their registration documents to their own folder.
    // 'write' includes create and update, necessary for the full upload flow.
    match /user-documents/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Dealers can read jacket documents (PDFs, etc.) if the jacket is assigned to them in Firestore.
    match /jacket-documents/{vin}/{allPaths=**} {
      allow read: if request.auth != null &&
                   get(/databases/(default)/documents/jackets/$(vin)).data.dealerId == request.auth.uid;
    }
  }
}
