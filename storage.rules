rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if the logged-in user is in the 'admins' collection in Firestore.
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Allow any authenticated user to read files.
    // For an internal tool, this is generally safe.
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Allow Admins to upload, update, and delete files within the jacket-documents folder.
    // This rule protects all files for all jackets.
    match /jacket-documents/{vin}/{allChildren=**} {
      allow write: if request.auth != null && isAdmin();
    }

    // Add other specific rules for other folders as needed.
    // E.g. match /invoices/{userId}/{fileName} { ... }
  }
}