rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }

    // TEMP DEV BYPASS (same UID as in Firestore rules)
    function isDevAdmin() {
      return signedIn() && request.auth.uid == "qY0IICPcxOSf8HTHwO83Qz6fxiG3";
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.role == 'admin') || isDevAdmin()
      );
    }

    // Dealer-owned documents (gov ID, tax cert, etc.)
    match /user-documents/{uid}/{path=**} {
      // Dealers can read their own files; admins can read all
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Dealers can write only to their own folder.
      // NOTE: Temporarily removed size and content-type checks for debugging.
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Invoice uploads for AI parsing
    match /invoice-uploads/{uid}/{path=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // NOTE: Temporarily removed size and content-type checks for debugging.
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
