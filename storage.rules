rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // A user can write any file to their own documents folder.
    // Only that user, or an admin, can read the files.
    match /dealer-documents/{uid}/{fileName} {
      allow write: if request.auth.uid == uid;
      allow read: if request.auth.uid == uid || request.auth.token.role == 'admin';
    }
  }
}
