rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // TEMP DEV BYPASS. Remove for production when custom claims are set.
    function isDevAdmin() {
      return signedIn() && request.auth.uid == "qY0IICPcxOSf8HTHwO83Qz6fxiG3";
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.role == 'admin') || isDevAdmin()
      );
    }

    // Only PDFs/images <= 10MB (adjust if needed)
    function isAllowedUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    // user-documents/{uid}/...
    match /user-documents/{userId}/{allPaths=**} {
      // Owner or admin can read
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();

      // Only the owner may upload/write
      allow write: if signedIn()
        && request.auth.uid == userId
        && isAllowedUpload();
    }
  }
}
