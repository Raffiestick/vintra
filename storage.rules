rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper Functions
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isJacketAssignedToUser(vin, userId) {
      // Correct syntax: get() is a global function, not namespaced under firestore.
      return get(/databases/$(database)/documents/jackets/$(vin)).data.dealerId == userId;
    }

    // ========== User Documents ==========
    // Dealers can only upload their own resale cert and gov ID.
    match /user-documents/{userId}/{fileName} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // ========== Jacket Documents ==========
    // Admins have full access. Dealers can only read documents for jackets assigned to them.
    match /jacket-documents/{vin}/{doc=**} {
      allow read: if isAdmin() || (request.auth != null && isJacketAssignedToUser(vin, request.auth.uid));
      allow write: if isAdmin();
    }

    // ========== Staging/Incoming Files ==========
    // Admins have full access. Authenticated users can upload to their own incoming folder.
    match /incoming/{path=**} {
      allow read, write: if isAdmin();
    }
    match /incoming/invoices/{userId}/{fileName} {
       allow write: if isOwner(userId);
    }

    // ========== Default Deny ==========
    // Deny all other access by default for security.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
