rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // --- THIS FUNCTION IS NOW CORRECTED ---
    // It now checks for the 'admin' custom claim on the user's token.
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // Allow any authenticated user to read files.
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Allow Admins to write to the jacket-documents folder.
    match /jacket-documents/{vin}/{allChildren=**} {
      allow write: if request.auth != null && isAdmin();
    }

    // Allow Admins to write files to the invoices folder.
    match /invoices/{userId}/{allChildren=**} {
        allow write: if request.auth != null && isAdmin();
    }
  }
}