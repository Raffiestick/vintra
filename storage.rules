rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions to check user roles, mirroring Firestore rules.
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }
    
    // Hard-coded admin UID for development bypass
    function isDevAdmin() {
      return isSignedIn() && request.auth.uid == "qY0IICPcxOSf8HTHwO83Qz6fxiG3";
    }

    // Allow users to upload their own application documents (resale cert, ID).
    match /user-documents/{userId}/{allPaths=**} {
      allow read: if isAdmin() || isDevAdmin();
      allow write: if request.auth.uid == userId;
    }

    // Allow admins to upload documents for any jacket.
    match /jacket-documents/{vin}/{allPaths=**} {
      allow write: if isAdmin() || isDevAdmin();
    }

    // Allow any authenticated user to read files. This is generally safe because
    // file paths are not guessable and access to the URLs is controlled by
    // your Firestore read rules.
    match /{allPaths=**} {
      allow read: if isSignedIn();
    }
  }
}
