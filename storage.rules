rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match the path for dealer documents, which are stored under `dealer-documents/{userId}/{fileName}`
    match /dealer-documents/{userId}/{allPaths=**} {
      // Allow a user to read and write files only in their own folder.
      // This is crucial for security.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
