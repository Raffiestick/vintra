rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check for admin role from custom claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Admins can do anything, anywhere.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Users can upload their own registration documents to their own folder.
    match /user-documents/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Users can read jacket documents if they are the assigned dealer.
    match /jacket-documents/{vin}/{allPaths=**} {
      allow read: if request.auth != null && 
                  firestore.exists(/databases/$(database)/documents/jackets/$(vin)) &&
                  firestore.get(/databases/$(database)/documents/jackets/$(vin)).data.dealerId == request.auth.uid;
    }
  }
}
