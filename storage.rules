rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }

    // TEMP: allow any signed-in user to upload invoices for testing
    match /stagingInvoices/{sid}/{file} {
      allow read, write: if isSignedIn();
    }

    // NOTE: Your other rules for user-documents, etc., can be added back here later.
  }
}