rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
  
    // Admins can access all files if needed.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Dealers can only write to their own designated folder.
    // They can upload their resell certificate and government ID.
    match /dealer-documents/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (fileName == 'resell-certificate.pdf' || fileName == 'government-id.pdf') // Example filenames
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/png|image/jpeg');
    }
  }
}
