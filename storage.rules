rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && (
             request.auth.token.admin == true
          || request.auth.token.role == 'admin'
          || request.auth.uid in ['8usUL5P3Lde9UmukTHNhfArzDbs2','qY0IICPcxOSf8HTHwO83Qz6fxiG3']
        );
    }

    // Admins = read/write everywhere
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Auction invoices: admin only
    match /incoming/invoices/{uid}/{fileName} {
      allow write, read: if isAdmin();
    }

    // Dealers upload their own registration docs
    match /user-documents/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Jacket docs: dealers assigned to the VIN can read; only admin can write/delete
    match /jacket-documents/{vin}/{allPaths=**} {
      allow read: if request.auth != null
        && (
             isAdmin()
          || firestore.get(/databases/(default)/documents/jackets/$(vin)).data.dealerId == request.auth.uid
        );
      allow write, delete: if isAdmin();
    }
  }
}
