
{
  "compilerOptions": {
    "outDir": "lib",
    "module": "commonjs",
    "target": "ES2020",
    "strict": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "@types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
